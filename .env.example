# Copiar a .env (fuera del webroot o protegido) y rellenar. NUNCA subir .env a git.
APP_URL=https://pdsx.org/love
APP_DEBUG=0

# --- Wompi El Salvador (https://panel.wompi.sv → tu aplicación → credenciales) ---
WOMPI_ENV=sandbox            # sandbox | production. Cualquier otro valor (o vacío) = production (más estricto)
WOMPI_CLIENT_ID=             # Client ID de la aplicación
WOMPI_API_SECRET=            # API Secret: autentica ante Wompi Y firma los webhooks (wompi_hash). Nunca en git.
PREMIUM_PRICE_USD=4.99       # en dólares, hasta 2 decimales, mínimo 0.01.
                             # El panel (/admin/promos.php) puede sobrescribirlo sin redesplegar.

# Solo sandbox (se ignoran en production): apuntar la API a un simulador local, p.ej. tests/mock_wompi.py
# WOMPI_TOKEN_URL=http://host.docker.internal:9090/connect/token
# WOMPI_API_URL=http://host.docker.internal:9090

# --- Base de datos MySQL 8.0+ (InnoDB, utf8mb4). Todas obligatorias salvo DB_PORT. ---
# El esquema se crea solo en el primer arranque; el usuario necesita CREATE/ALTER/INDEX/REFERENCES
# además de SELECT/INSERT/UPDATE/DELETE sobre DB_NAME.
DB_HOST=db                   # con docker-compose: el servicio "db". En hosting compartido: 127.0.0.1
DB_PORT=3306
DB_NAME=lovepages
DB_USER=lovepages
DB_PASSWORD=                 # contraseña larga y aleatoria. Nunca en git.
# Solo docker-compose: contraseña de root del servicio MySQL (no la usa la aplicación).
DB_ROOT_PASSWORD=

# --- Datos legales (páginas /terms.php y /privacy.php) ---
LEGAL_ENTITY=PDSX            # nombre del responsable que aparece en los documentos
LEGAL_EMAIL=                 # correo público para solicitudes de privacidad y reembolsos por error de cobro

# --- Correo de soporte y verificación de cuentas ---
# La cuenta de Hostinger debe usar la misma contraseña para SMTP e IMAP.
MAIL_SUPPORT_EMAIL=soporte@pdsx.org
MAIL_FROM_EMAIL=soporte@pdsx.org
MAIL_FROM_NAME=PDSX
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=soporte@pdsx.org
SMTP_PASSWORD=             # contraseña de soporte@pdsx.org; nunca subirla a git
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=soporte@pdsx.org
IMAP_PASSWORD=             # contraseña de soporte@pdsx.org; nunca subirla a git

# --- Inicio de sesión con Google (OAuth 2.0) ---
# Google Cloud Console → APIs y servicios → Pantalla de consentimiento OAuth (app «externa» y
# en producción) y → Credenciales → ID de cliente OAuth 2.0 → «Aplicación web». Mientras falte
# algo de esto, el botón de Google no se muestra (google_configured() en config/google.php).
GOOGLE_CLIENT_ID=         # termina en .apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=     # Client Secret: autentica la app ante Google. Nunca en git.
                          # URI de redirección autorizada. Debe coincidir EXACTAMENTE con la que
                          # envía la app (mismo esquema, host, puerto, ruta y sin query). Si se
                          # deja vacía se usa <APP_URL>/auth/google_callback.php.
GOOGLE_REDIRECT_URI=https://pdsx.org/love/auth/google_callback.php
