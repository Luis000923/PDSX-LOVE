# Copiar a .env (fuera del webroot o protegido) y rellenar. NUNCA subir .env a git.
APP_URL=https://pdsx.org/love
APP_DEBUG=0

WOMPI_ENV=sandbox            # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
PREMIUM_PRICE_COP=19900      # en pesos; se convierte a centavos.
                             # El panel (/admin/promos.php) puede sobrescribirlo sin redesplegar.

# Docker: ruta de la BD dentro del contenedor (volumen persistente)
DB_PATH=/var/www/data/store.sqlite
