# Red de seguridad si el docroot es la raíz del proyecto: nunca servir .env ni archivos ocultos.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Nada de esto debe servirse por web: solo public/ es la aplicación.
RedirectMatch 403 ^/(vendor|bin|tests|\.github|\.opencode|\.claude|pdsx-love)(/|$)
<FilesMatch "^(composer\.(json|lock)|phpunit\.xml|phpstan\.neon|Dockerfile|docker-compose\.yml|README.*)$">
    Require all denied
</FilesMatch>

# Los usuarios entran por pdsx.org: la raíz lleva a la aplicación.
RedirectMatch 302 ^/$ /love/
