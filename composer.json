{
    "name": "pdsx/love",
    "description": "LovePages - micro-SaaS de páginas de amor (pdsx.org/love)",
    "type": "project",
    "license": "proprietary",
    "require": { "php": ">=8.2", "ext-pdo_mysql": "*", "ext-mbstring": "*", "ext-curl": "*", "ext-zip": "*" },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "config": { "sort-packages": true, "optimize-autoloader": true },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M"
    }
}
