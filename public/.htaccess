Options -Indexes
RewriteEngine On
# Wompi firma el webhook con la cabecera `wompi_hash`; Apache/LiteSpeed descartan las cabeceras con "_", así que se reexpone.
RewriteCond %{HTTP:wompi_hash} (.+)
RewriteRule ^webhook_wompi\.php$ - [E=HTTP_WOMPI_HASH:%1]
# Página pública de pareja: /c/abc12345
RewriteRule ^c/([a-z0-9]{6,12})/?$ view.php?u=$1 [L,QSA]
# Documento aislado (HTML propio del usuario), servido por frame.php con CSP `sandbox`
RewriteRule ^c/([a-z0-9]{6,12})/f$ frame.php?u=$1 [L,QSA]
# Fotos y recursos de usuarios: nunca código ni HTML servido directamente (insensible a mayúsculas)
RewriteRule ^uploads/.*\.(php\d?|phtml|phar|html?|xhtml|shtml)$ - [F,L,NC]
# Los assets de plantillas nunca se ejecutan (defensa en profundidad: solo se copian extensiones estáticas)
RewriteRule ^assets/.*\.(php|phtml|phar)$ - [F,L]
# Errores con la marca de la app (el código HTTP original se conserva; ver public/error.php)
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 410 /error.php
ErrorDocument 500 /error.php
